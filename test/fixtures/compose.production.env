# Synthetic values only. Compose is always given this explicit env file so it
# never discovers a developer's real .env file.
APP_ENV=production
APP_VERSION=1234567890abcdef1234567890abcdef12345678
FE_IMAGE=registry.example.invalid/delta/frontend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BE_IMAGE=registry.example.invalid/delta/backend@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
CLOUD_PROVIDER=gcp
LOG_DRIVER=gcplogs
GCP_PROJECT_ID=term2-delta
GOOGLE_CLOUD_PROJECT=term2-delta
AWS_REGION=ap-northeast-2
AWS_LOG_GROUP=/delta/workload/contract-test
BE_SECRET_FILE=/tmp/delta-contract-only/backend.env
