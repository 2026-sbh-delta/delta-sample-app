# Docker Compose settings. Local Node execution uses frontend/.env and backend/.env.
FE_PORT=3000
BE_PORT=8080
API_HOST=backend
# Blank means the same port as BE_PORT. Set explicitly for a remote backend.
API_PORT=
API_PROTOCOL=http
API_ENDPOINT=/api
API_TIMEOUT_MS=5000
APP_NAME=Delta Board
CLOUD_PROVIDER=auto
APP_ENV=local
APP_VERSION=dev
FE_IMAGE=delta-sample-frontend:local
BE_IMAGE=delta-sample-backend:local
