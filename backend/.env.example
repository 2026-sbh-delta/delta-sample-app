HOST=0.0.0.0
PORT=8080
API_ENDPOINT=/api
APP_ENV=local
APP_VERSION=dev
# Leave empty when using the FE proxy. For direct browser calls, list exact origins.
CORS_ORIGINS=

# Default remains memory. PostgreSQL deployment injects all PG settings at runtime.
STORAGE_BACKEND=memory
# PGHOST=your-database-endpoint
# PGPORT=5432
# PGDATABASE=delta_notes
# PGUSER=delta_notes_app
# PGPASSWORD is injected from a secret; do not commit it.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/path/to/rds-ca.pem
